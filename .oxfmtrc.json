{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "proseWrap": "preserve",
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": false,
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "next-env.d.ts",
    "*.tsbuildinfo",
    "package-lock.json",
    "skills-lock.json",
    ".agents/skills/",
    ".claude/skills/",
    "CLAUDE.md",
    "public/icons/catppuccin/"
  ],
  "overrides": [
    {
      "files": ["**/*.md"],
      "options": {
        "proseWrap": "always"
      }
    }
  ]
}
